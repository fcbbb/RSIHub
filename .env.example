# Copy to .env and fill in real values. .env is gitignored.
# Never commit this file with credentials in it.

# Candidate and judge key. ReviewBench reads it from RB_HARBOR_OPENAI_API_KEY
# in the verifier; prepare.sh derives that from OPENAI_API_KEY unless set.
OPENAI_API_KEY=replace-me

# Endpoint used by the candidate. dsh needs an Anthropic Messages endpoint;
# use .../apps/anthropic for an endpoint whose OpenAI-compatible path is
# .../compatible-mode/v1. prepare.sh performs that mapping automatically.
OPENAI_BASE_URL=https://your-endpoint.example/apps/anthropic

# Optional: OpenAI-compatible endpoint used by LLM judges that read the
# standard SDK variables (SWE-Atlas reads OPENAI_API_BASE in its verifier).
# OPENAI_API_BASE=https://your-endpoint.example/compatible-mode/v1

# Optional: judge model id for SWE-Atlas. Its default
# `anthropic/claude-opus-4-5-20251101` must exist on the endpoint above.
# EVAL_MODEL=replace-me

# Optional: separate key for the ReviewBench judge.
# RB_HARBOR_OPENAI_API_KEY=replace-me

# Optional: override the dsh runtime image. It must match the recipe.
# DSH_RUNTIME_IMAGE=evolve-mutate-dsh:20261104-dsh021rc5

# Optional: Docker CLI config with empty proxies, for a host whose Docker
# daemon still points at a dead proxy.
# DOCKER_CONFIG=/absolute/path/to/RSIHub/scripts/reviewbench/docker-config