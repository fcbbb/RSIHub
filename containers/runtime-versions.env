# Optional immutable pin. Docker tags are mutable: rebuilding the same tag with a
# changed Dockerfile silently changes the runtime every trial installs. When set,
# prepare-runtime.sh fails unless the local image ID matches, so a rebuild is a
# deliberate act (update this line) instead of an accident. Emit the current ID
# with: docker image inspect --format '{{.Id}}' "$DSH_MUTATE_IMAGE"
DSH_MUTATE_IMAGE_ID=sha256:7bdbd42bf4b7c6577a9dc242c54701233379e2a4923abc69daffd5191c8d1fe5
